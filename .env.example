# Exemple sans secret. Utiliser une base de test dédiée.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:55432/beyond_pilot_elearning?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:55432/beyond_pilot_elearning?schema=public"
# API : copier dans apps/api/.env
PORT=4200
BIND_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3200
COOKIE_SECURE=false
VIDEO_ALLOWED_HOSTS=
# Next : copier dans apps/web/.env.local
API_INTERNAL_URL=http://127.0.0.1:4200/api/v1
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3200
NEXT_PUBLIC_LAB_ORIGIN=http://127.0.0.1:3201
PREPRODUCTION=true
# Laboratoire : origine distincte du site, HTTPS pour un accès distant.
LAB_PORT=3201
LAB_BIND_HOST=127.0.0.1
LAB_ORIGIN=http://127.0.0.1:3201
# Docker facultatif, secret requis avant initialisation.
POSTGRES_PASSWORD=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
